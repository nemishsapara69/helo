# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode for /admin moderation console.
# If left empty, an inline first-run admin setup form allows claiming access once.
ADMIN_PASSCODE=""

# JWT_SECRET: REQUIRED in production. Secret used to sign auth tokens.
# If unset, a random secret is generated per process start, which means
# every server restart invalidates all user sessions and refresh tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# TURN_URL / TURN_USERNAME / TURN_CREDENTIAL: Optional TURN relay server.
# WebRTC video/audio fails for users behind symmetric NAT or corporate
# firewalls without a TURN server. STUN alone is not enough there.
# Example TURN_URL:  turn:turn.example.com:3478?transport=udp
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# PORT: Port the server listens on (defaults to 3000).
PORT="3000"

# NODE_ENV: Set to "production" to serve the built frontend from dist/
# and disable Vite dev middleware. Set to "development" (or leave unset) for dev mode.
NODE_ENV=""

# DISABLE_HMR: Set to any value to disable Vite hot-module replacement in dev mode.
DISABLE_HMR=""

# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / MAIL_FROM: Optional SMTP
# configuration for sending transactional email (password resets, etc).
# Without these, password reset links are logged to the server console
# instead of being emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Helo <no-reply@helo.example.com>"
